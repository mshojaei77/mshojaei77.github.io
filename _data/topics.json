  "clusters": {
    "ai_agents": {
      "labels": {
        "en": "AI Agents",
        "fa": "ایجنت‌های هوش مصنوعی"
      },
      "descriptions": {
        "en": "Agent engineering combines model decisions with tools, state, context and control flow. Identify which behavior is delegated to a model and which must remain deterministic.",
        "fa": "مهندسی عامل، تصمیم‌های مدل را با ابزار، state، context و control flow ترکیب می‌کند. مشخص کنید کدام رفتار به مدل سپرده می‌شود و کدام بخش باید قطعی بماند."
      },
      "concepts": {
        "en": ["Workflow versus agent", "Tool contracts and state", "Context construction", "Reliability and evaluation"],
        "fa": ["تفاوت workflow و agent", "قرارداد ابزار و state", "ساخت context", "قابلیت اتکا و ارزیابی"]
      },
      "failure_modes": {
        "en": ["Unbounded retries or duplicate side effects", "State loss in long runs", "Treating tool success as task success"],
        "fa": ["retry نامحدود یا اثر جانبی تکراری", "از دست‌رفتن state در اجرای طولانی", "یکی‌گرفتن اجرای موفق ابزار با موفقیت وظیفه"]
      },
      "articles": [
        "agent-vs-workflow",
        "context-engineering-agents",
        "agent-harness",
        "agent-skills",
        "agent-production-failures",
        "context-compaction-agents",
        "agent-costs",
        "voice-agent-architecture",
        "deep-research-agents",
        "academic-research-agent",
        "ai-agent-use-cases",
        "secure-nl2sql"
      ]
    },
    "rag_document_intelligence": {
      "labels": {
        "en": "Production RAG & Document Intelligence",
        "fa": "RAG عملیاتی و هوش اسناد"
      },
      "descriptions": {
        "en": "Retrieval systems depend on document ingestion, representations, ranking and context assembly. Inspect each stage before attributing an incorrect answer to generation.",
        "fa": "سامانهٔ بازیابی به ingestion سند، بازنمایی، رتبه‌بندی و ساخت context وابسته است. پیش از نسبت‌دادن پاسخ نادرست به generation، هر مرحله را بررسی کنید."
      },
      "concepts": {
        "en": ["Document parsing and structure", "Chunking and representations", "Lexical, vector and hybrid retrieval", "Context selection and failure diagnosis"],
        "fa": ["استخراج ساختار سند", "chunking و بازنمایی", "بازیابی واژگانی، برداری و ترکیبی", "انتخاب context و عیب‌یابی"]
      },
      "failure_modes": {
        "en": ["Lost reading order or table structure", "Retrieval misses hidden by fluent generation", "Chunk boundaries that break evidence"],
        "fa": ["ازبین‌رفتن ترتیب خواندن یا ساختار جدول", "پنهان‌شدن خطای retrieval پشت پاسخ روان", "مرز chunk نامناسب برای شواهد"]
      },
      "articles": [
        "embeddings",
        "persian-embedding-models",
        "chunking-strategies",
        "vector-databases",
        "contextual-retrieval",
        "multi-representation-retrieval",
        "production-rag-architecture",
        "rag-failure-diagnostics",
        "document-parsing",
        "build-search-engine-from-scratch"
      ]
    },
    "llm_architecture": {
      "labels": {
        "en": "LLM Architecture",
        "fa": "معماری LLM"
      },
      "descriptions": {
        "en": "Explore how tokenization, model blocks and design choices shape the representations and behavior of large language models.",
        "fa": "بررسی کنید tokenization، بلوک‌های مدل و انتخاب‌های طراحی چگونه بر بازنمایی و رفتار مدل‌های زبانی بزرگ اثر می‌گذارند."
      },
      "concepts": {
        "en": ["Tokens and embeddings", "Attention and Transformer blocks", "Feed-forward components", "Open model constraints"],
        "fa": ["توکن و embedding", "attention و بلوک‌های Transformer", "اجزای feed-forward", "محدودیت‌های مدل‌های باز"]
      },
      "failure_modes": {
        "en": ["Assuming token counts equal character counts", "Confusing model architecture with application behavior", "Overgeneralizing from one model family"],
        "fa": ["برابرگرفتن تعداد توکن و نویسه", "اشتباه‌گرفتن معماری مدل با رفتار برنامه", "تعمیم یک خانوادهٔ مدل به همهٔ مدل‌ها"]
      },
      "articles": [
        "intro-to-llms",
        "tokenization",
        "llm-architecture",
        "swiglu",
        "open-source-ai",
        "when-not-to-use-llm",
        "decision-models-vs-llms"
      ]
    },
    "training_optimization": {
      "labels": {
        "en": "Training & Optimization",
        "fa": "آموزش و بهینه‌سازی مدل"
      },
      "descriptions": {
        "en": "Study how objectives, update rules and post-training procedures change model behavior. Interpret comparisons in the context of their stated data, setup and evaluation.",
        "fa": "بررسی کنید objective، قواعد به‌روزرسانی و مراحل post-training چگونه رفتار مدل را تغییر می‌دهند؛ مقایسه‌ها را با توجه به داده، setup و ارزیابی گزارش‌شده تفسیر کنید."
      },
      "concepts": {
        "en": ["Optimizer behavior", "Fine-tuning and post-training", "Distillation and model merging", "Evaluation of training changes"],
        "fa": ["رفتار optimizer", "fine-tuning و post-training", "distillation و ادغام مدل", "ارزیابی تغییرات آموزش"]
      },
      "failure_modes": {
        "en": ["Comparing runs with different data or schedules", "Confusing training loss with task quality", "Omitting inference-time trade-offs"],
        "fa": ["مقایسهٔ اجراها با داده یا زمان‌بندی متفاوت", "یکی‌گرفتن training loss با کیفیت وظیفه", "نادیده‌گرفتن موازنه‌های زمان inference"]
      },
      "articles": [
        "muon-vs-adamw",
        "efficient-fine-tuning",
        "llm-post-training",
        "rl-in-llms",
        "knowledge-distillation",
        "llm-model-merging"
      ]
    },
    "evaluation_persian_ai": {
      "labels": {
        "en": "Evaluation & Persian AI",
        "fa": "ارزیابی و هوش مصنوعی فارسی"
      },
      "descriptions": {
        "en": "Evaluation connects task definition, data provenance, metrics, execution conditions and interpretation. Persian AI evaluation also needs transparent treatment of script, dialect, code-switching and annotation.",
        "fa": "ارزیابی، تعریف وظیفه، provenance داده، معیار، شرایط اجرا و تفسیر را به هم پیوند می‌دهد. در ارزیابی هوش مصنوعی فارسی، خط، گونهٔ زبانی، code-switching و حاشیه‌نویسی هم باید شفاف بررسی شوند."
      },
      "concepts": {
        "en": ["Dataset construction and provenance", "Metrics and aggregation", "Human review and eligibility", "Synthetic versus real-world evidence"],
        "fa": ["ساخت داده و provenance", "معیار و تجمیع", "بازبینی انسانی و صلاحیت", "شواهد مصنوعی در برابر دنیای واقعی"]
      },
      "failure_modes": {
        "en": ["Treating synthetic cases as real-world validation", "Comparing incompatible task coverage", "Claiming human validation without evidence"],
        "fa": ["تعبیر سناریوی مصنوعی به‌عنوان اعتبارسنجی واقعی", "مقایسهٔ وظایف با پوشش ناسازگار", "ادعای بازبینی انسانی بدون مدرک"]
      },
      "articles": [
        "persian-open-ai-ecosystem",
        "persian-llm-evaluation",
        "persian-embedding-models",
        "massive-intent-benchmark",
        "tasmim-bench",
        "ai-reasoning-evaluation",
