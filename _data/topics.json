      "descriptions": {
        "en": "Connect model choice to serving, memory, latency, throughput and cost. Configuration examples are workload-specific; validate them on the target runtime and hardware.",
        "fa": "انتخاب مدل را به serving، حافظه، latency، throughput و هزینه وصل کنید. مثال‌های پیکربندی به workload وابسته‌اند و باید روی runtime و سخت‌افزار مقصد سنجیده شوند."
      },
      "concepts": {
        "en": ["Weights and quantization", "KV cache and context", "Serving configuration", "Latency, throughput and capacity"],
        "fa": ["وزن و quantization", "KV cache و context", "پیکربندی serving", "latency، throughput و ظرفیت"]
      },
      "failure_modes": {
